{
  "name": "ontology-query-platform",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:api": "node --watch server/src/server.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:api": "node server/src/server.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test server/test/*.test.mjs",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "eval:loop-v2:readiness": "node scripts/eval-readiness.mjs --manifest examples/evaluation/loop-v2-rock-readonly.candidate.json",
    "check": "npm run lint && npm run build && npm run test && npm run test:rendered",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.258",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "13.0.3",
    "mysql2": "3.14.5",
    "node-sql-parser": "5.3.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "type": "module",
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.2": true,
    "workerd@1.20260811.1": true
  }
}
