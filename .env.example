# Web UI -> local API service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api
NEXT_PUBLIC_API_WRITE_TOKEN=replace-with-a-local-write-token

# Local API service
API_PORT=8787
API_HOST=127.0.0.1
BUSINESS_TIME_ZONE=Asia/Shanghai
API_WRITE_TOKEN=replace-with-a-local-write-token
# 生产环境优先使用角色身份；sourceIds 可为 "*" 或数据源 ID 数组。
# AI 本体 M4 独立双检需要两个 name 不同的 editor/admin 身份。
# API_IDENTITIES_JSON=[{"name":"platform-admin","role":"admin","token":"replace-me","sourceIds":"*"},{"name":"ontology-reviewer-a","role":"editor","token":"replace-reviewer-a","sourceIds":[1]},{"name":"ontology-reviewer-b","role":"editor","token":"replace-reviewer-b","sourceIds":[1]},{"name":"analyst-a","role":"analyst","token":"replace-me-too","sourceIds":[1]}]
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_SECRET=replace-with-at-least-32-random-characters
PLATFORM_DB_PATH=.data/platform.sqlite
ONTOLOGY_WIKI_DIR=.ontology-wiki/wiki

# Optional OpenAI-compatible model endpoint. Without these values the sample
# workspace uses a deterministic demo query planner.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-model-api-key
LLM_MODEL=qwen3.8-max

# Optional OpenAI-compatible embedding endpoint for hybrid retrieval. All values
# below can also be managed at runtime from the in-app 设置中心 (admin only);
# database-stored settings take precedence over these env defaults.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1024

# Hybrid retrieval tuning (also editable in 设置中心)
RETRIEVAL_VECTOR_ENABLED=true
RETRIEVAL_TOP_K=8
RETRIEVAL_VECTOR_WEIGHT=0.4
RETRIEVAL_MIN_SIMILARITY=0.35
RETRIEVAL_SEMANTIC_THRESHOLD=0.55

# Relation discovery: metadata is judged in bounded batches. Raw rows never enter
# prompts; only the explicitly enabled, value-redacted column profile may be sent.
RELATION_MODEL_MAX_CANDIDATES=600
RELATION_MODEL_BATCH_SIZE=8
RELATION_MODEL_TIMEOUT_MS=180000
RELATION_MODEL_MIN_CONFIDENCE=0.55
RELATION_VALUE_SAMPLE_LIMIT=500
RELATION_OVERLAP_CONCURRENCY=4
RELATION_OVERLAP_TIMEOUT_MS=10000

# Redacted column profiles are disabled by default and only cover A/B tables.
COLUMN_PROFILING_ENABLED=false
COLUMN_PROFILING_SAMPLE_LIMIT=1000
COLUMN_PROFILING_MAX_TABLES=20
COLUMN_PROFILING_TIMEOUT_MS=10000

# AI-assisted ontology modeling is disabled by default. review routes every valid
# candidate to a human; auto_draft enables deterministic >= threshold confirmation.
ONTOLOGY_AI_MODELING_MODE=off
ONTOLOGY_AI_AUTO_CONFIRM_SCORE=80
ONTOLOGY_AI_MAX_TABLES=20
ONTOLOGY_AI_MAX_FIELDS=600
ONTOLOGY_AI_LLM_TIMEOUT_MS=300000
# Critic only forces review; failures degrade to skipping the critic.
ONTOLOGY_AI_CRITIC_ENABLED=false
ONTOLOGY_AI_CALIBRATION_MIN_SAMPLES=40
ONTOLOGY_AI_CALIBRATION_MIN_PRECISION=0.95
ONTOLOGY_AI_MAX_MANUAL_OBJECT_RATE=0.20
ONTOLOGY_AI_MAX_FAILURE_RATE=0.05
ONTOLOGY_AI_MAX_P95_LATENCY_MS=90000
ONTOLOGY_AI_MAX_AVERAGE_TOKENS=50000
# Full prompts and raw model outputs are stored here with restricted permissions.
ONTOLOGY_AI_AUDIT_DIR=.data/ontology-generation

# Query safety defaults
QUERY_TIMEOUT_MS=30000
QUERY_LLM_TIMEOUT_MS=90000
QUERY_MAX_ROWS=500
EXPLAIN_MAX_ROWS=1000000
# off: 保持兼容链路；prefer: 优先语义计划并安全回退；required: 仅允许语义计划。
SEMANTIC_QUERY_PLAN_MODE=off
# off: 保持单发管道；prefer: 单发需要探索或首次护栏/执行失败时升级 Agent；required: 仅运行 Agent Loop。
QUERY_AGENT_MODE=off
# 仅在 prefer 模式生效；按会话稳定分桶。生产建议门禁通过后按 10 → 30 → 100 放量。
QUERY_AGENT_TRAFFIC_PERCENT=100
QUERY_AGENT_MAX_ITERATIONS=8
QUERY_AGENT_MAX_SQL_CALLS=5
QUERY_AGENT_MAX_SCANNED_ROWS=5000000
QUERY_AGENT_PENDING_TTL_MS=600000

# Claude Code query bridge (disabled by default). The Anthropic key is a
# deployment-only secret and is never persisted in the SQLite settings table.
CLAUDE_QUERY_MODE=off
CLAUDE_QUERY_TRAFFIC_PERCENT=0
CLAUDE_QUERY_BINARY=/app/node_modules/.bin/claude
# DashScope Anthropic-compatible example; keep the bridge disabled until preflight passes.
# ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
# Use an exact model ID; leave empty while the bridge is disabled.
CLAUDE_QUERY_MODEL=
CLAUDE_QUERY_PROMPT_VERSION=claude-query-v1
CLAUDE_QUERY_TIMEOUT_MS=120000
CLAUDE_QUERY_MAX_TURNS=12
CLAUDE_QUERY_MAX_BUDGET_USD=1
CLAUDE_QUERY_MAX_CONCURRENCY=2
CLAUDE_QUERY_QUEUE_TIMEOUT_MS=5000
CLAUDE_QUERY_MAX_STDIO_BYTES=2097152
# ANTHROPIC_API_KEY=replace-with-anthropic-secret

RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_READ_PER_MINUTE=300
