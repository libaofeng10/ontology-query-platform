# Copy to repository root as .env.production and replace every placeholder.
API_IDENTITIES_JSON=[{"name":"platform-admin","role":"admin","token":"replace-with-random-admin-token","sourceIds":"*"},{"name":"analyst-a","role":"analyst","token":"replace-with-random-analyst-token","sourceIds":[1]}]
API_WRITE_TOKEN=replace-with-disabled-fallback-token
APP_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000
BUSINESS_TIME_ZONE=Asia/Shanghai
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=replace-with-model-api-key
LLM_MODEL=replace-with-model-name
# Claude Code query bridge. Keep off until the deployment preflight and gate pass.
CLAUDE_QUERY_MODE=off
CLAUDE_QUERY_TRAFFIC_PERCENT=0
CLAUDE_QUERY_BINARY=/app/node_modules/.bin/claude
# DashScope Anthropic-compatible endpoint (北京地域)
ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic
CLAUDE_QUERY_MODEL=glm-5.2-fast-preview
CLAUDE_QUERY_PROMPT_VERSION=claude-query-v1
CLAUDE_QUERY_TIMEOUT_MS=120000
CLAUDE_QUERY_MAX_TURNS=12
CLAUDE_QUERY_MAX_BUDGET_USD=1
CLAUDE_QUERY_MAX_CONCURRENCY=2
CLAUDE_QUERY_QUEUE_TIMEOUT_MS=5000
CLAUDE_QUERY_MAX_STDIO_BYTES=2097152
# Inject ANTHROPIC_API_KEY through the deployment secret manager; do not commit it.
QUERY_TIMEOUT_MS=30000
QUERY_MAX_ROWS=500
EXPLAIN_MAX_ROWS=1000000
RATE_LIMIT_QUERY_PER_MINUTE=30
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_READ_PER_MINUTE=300
